aders.get('Content-Disposition') || '';\n      const m = cd.match(/filename=\"?([^\"]+)\"?/);\n      const filename = m && m[1] || `reporte_${period}.docx`;\n      const blob = await res.blob();\n      return {\n        blob,\n        filename\n      };\n    },\n    /** Exportar a PowerPoint (.pptx). period: today | yesterday | week | month */\n    downloadReportsPptx: async (pid, period, opts) => {\n      const tok = await _srcUtilsStorage.storage.secureGet('syncsite_token', '');\n      const qs = new URLSearchParams({\n        period\n      });\n      if (opts?.area_id) qs.set('area_id', opts.area_id);\n      if (opts?.scope) qs.set('scope', opts.scope);\n      const res = await fetch(`${BASE}/projects/${pid}/export/reports.pptx?${qs.toString()}`, {\n        method: 'GET',\n        headers: tok ? {\n          Authorization: `Bearer ${tok}`\n        } : {}\n      });\n      if (!res.ok) {\n        const txt = await res.text();\n        let msg = `HTTP ${res.status}`;\n        try {\n          const j = JSON.parse(txt);\n          msg = j?.detail || msg;\n        } catch {}\n        throw new ApiError(res.status, msg);\n      }\n      const cd = res.headers.get('Content-Disposition') || '';\n      const m = cd.match(/filename=\"?([^\"]+)\"?/);\n      const filename = m && m[1] || `reporte_${period}.pptx`;\n      const blob = await res.blob();\n      return {\n        blob,\n        filename\n      };\n    },\n    // ---- Events (Calendario) ------------------------------------------------\n    listEvents: (pid, range = 'upcoming', limit = 500) => request('GET', `/projects/${pid}/events?range=${range}&limit=${limit}`),\n    createEvent: (pid, payload) => request('POST', `/projects/${pid}/events`, payload),\n    updateEvent: (eid, payload) => request('PATCH', `/events/${eid}`, payload),\n    deleteEvent: eid => request('DELETE', `/events/${eid}`),\n    deleteReport: rid => request('DELETE', `/reports/${rid}`),\n    // Users (admin)\n    listProjectUsers: pid => reques