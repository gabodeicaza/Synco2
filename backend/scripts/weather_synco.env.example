# Copia este archivo a ".env" en esta misma carpeta (backend/scripts/) y
# rellena los valores reales. ".env" NUNCA se commitea (ver .gitignore raíz:
# ".env", ".env.*", "*.env") -- vive solo en el servidor de producción,
# creado a mano ahí, fuera del repo.
#
# Usuario recomendado: crea un usuario Coordinador General dedicado para
# esta automatización (ej. "clima-automatico@tuempresa.com") en vez de usar
# tu propia cuenta personal, para poder revocar/rotar sus credenciales sin
# afectar tu acceso ni el de nadie más, y para que "captured_by_name" en
# los weather_logs se identifique como la automatización, no como una
# persona.

SYNCO_BASE_URL=https://apm-app.mx/api
SYNCO_EMAIL=
SYNCO_PASSWORD=

# Zona UTM (norte) de tus proyectos -- 14 es correcto para Ciudad de México.
# Si algún proyecto futuro cae en otra región del país, este valor global
# ya no sirve para ese proyecto -- ver la advertencia en el docstring de
# weather_openmeteo_export.py.
SYNCO_UTM_ZONE=14
